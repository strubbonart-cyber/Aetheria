{
  "schemaVersion": 1,
  "id": "skyblockqol",
  "version": "${version}",
  "name": "Skyblock QoL: Aetheria Fabric Port",
  "description": "Unofficial, incremental Minecraft 1.21.11 Fabric port of Aetheria. Includes a dedicated in-game settings GUI, mining trackers, Garden and pest tools, dungeon overlays and map tools, item utilities, and calculator features.",
  "authors": [
    "Original Aetheria contributors",
    "strubbonart-cyber"
  ],
  "contact": {
    "sources": "https://github.com/strubbonart-cyber/Aetheria",
    "issues": "https://github.com/strubbonart-cyber/Aetheria/issues"
  },
  "license": "AML-1.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.strubbonart.skyblockqol.SkyblockQolClient"
    ]
  },
  "mixins": [
    "skyblockqol.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
